# Server URL
URL=http://localhost:3000

# Authentication token for protected endpoints
AUTH_TOKEN=your-auth-token-here

# Discord webhook for notifications (optional)
DISCORD_WEBHOOK=

# Files directory path (optional, defaults to ./files)
FILES_DIR=

# Public site name and description
NAME=File Server
DESCRIPTION=A file hosting service

# Author information
AUTHOR=Your Name
AUTHOR_ID=your-id
